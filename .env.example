# --- Obligatorias ---------------------------------------------------------------------------------------------
# Administrador único (se crea en el primer arranque; después el registro público queda bloqueado)
ADMIN_EMAIL=admin@tu-dominio.com
ADMIN_PASSWORD=cambia-esto-min-8
# Clave de cifrado de credenciales de Proton y de Better Auth (>= 32 caracteres): openssl rand -hex 32
SECRET_KEY=
# URL pública exacta, sin barra final. Es el issuer OAuth y el recurso MCP: https://proton-mcp.tu-dominio.com
PUBLIC_URL=https://proton-mcp.tu-dominio.com
# PostgreSQL: usuarios, sesiones, API keys, tokens OAuth y correos guardados. En docker-compose se construye solo.
POSTGRES_PASSWORD=
# Solo desarrollo local sin compose:
# DATABASE_URL=postgres://proton:proton@localhost:5432/proton

# --- Opcionales (valores por defecto pensados para un VPS pequeño) ---------------------------------------------
DATA_DIR=./data
BROWSER_IDLE_MS=90000
MAX_BROWSERS=1
BROWSER_SHELL=true
BROWSER_LEAN=true
BROWSER_HEAP_MB=384
HEADLESS=true
BATCH_DEADLINE_MS=100000

# Sincronización automática de correos (0 = desactivada). Solo cuentas con sesión activa e interruptor encendido.
SYNC_INTERVAL_MIN=15
SYNC_MAX_BODIES=15
SYNC_RECENT_LIMIT=300

# Adjuntos e imágenes de los correos: se cifran (AES-256-GCM) ANTES de guardarse. Sin S3_* van a PostgreSQL (bytea).
# Cualquier almacén S3 compatible: MinIO, Cloudflare R2 (S3_REGION=auto), Backblaze B2, Garage, Wasabi, AWS…
# S3_ENDPOINT=https://s3.tu-dominio.com
# S3_BUCKET=proton-mcp
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
# S3_PATH_STYLE=true
MAX_ATTACHMENT_MB=10
# Pulsa "Cargar contenido remoto" al leer para guardar las imágenes (pasan por el proxy de Proton). false = no cargarlas.
LOAD_REMOTE_CONTENT=true
